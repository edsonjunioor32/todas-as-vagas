[Unit]
Description=Executa a coleta privada de descricoes durante a madrugada

[Timer]
OnCalendar=*-*-* 02:00:00 UTC
OnCalendar=*-*-* 02:15:00 UTC
OnCalendar=*-*-* 03:00:00 UTC
OnCalendar=*-*-* 03:45:00 UTC
Persistent=true
RandomizedDelaySec=300
Unit=todas-as-vagas-descriptions.service

[Install]
WantedBy=timers.target
