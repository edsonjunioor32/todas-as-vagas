{
  "name": "todas-as-vagas-multiportal",
  "version": "3.7.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "discover:inhire": "node busca_vagas/harvest_inhire_public.js",
    "discover:greenhouse-br": "python jobs-dashboard/discover_greenhouse_br.py",
    "build:inhire": "node busca_vagas/build_public_inhire.js",
    "validate:inhire": "node busca_vagas/validate_public_inhire.js",
    "build:pages": "python jobs-dashboard/pipeline_fit.py",
    "validate:pages": "python jobs-dashboard/validate_snapshot.py && python jobs-dashboard/validate_fit.py",
    "test:fit": "node tools/fit-engine.test.mjs",
    "prepare:fit": "python tools/prepare_fit_assets.py",
    "update:pages": "npm run build:inhire && npm run validate:inhire && npm run build:pages && npm run validate:pages"
  },
  "dependencies": {
    "mammoth": "1.12.1",
    "pdfjs-dist": "6.2.108"
  }
}
